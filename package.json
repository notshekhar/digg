{
    "name": "digg",
    "version": "1.0.0",
    "description": "digg \u2014 a Kubernetes cockpit in your browser, driven by your local kubectl.",
    "type": "module",
    "license": "MIT",
    "bin": {
        "digg": "./src/cli.ts"
    },
    "files": [
        "src",
        "examples"
    ],
    "scripts": {
        "start": "bun ./src/cli.ts",
        "build": "bun build-bin.ts",
        "build:web": "cd web && bun install && bun run build",
        "test": "bun test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@types/configstore": "^6.0.2",
        "configstore": "^8.0.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/bun": "latest"
    }
}
